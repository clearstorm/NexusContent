<?xml version="1.0"?>
<ruleset name="NexusContent Companion">
  <description>WordPress coding standards for the NexusContent Companion plugin.</description>

  <file>nexuscontent.php</file>
  <file>includes</file>

  <arg name="basepath" value="."/>
  <arg name="colors"/>
  <arg value="ps"/>
  <arg name="extensions" value="php"/>

  <config name="minimum_supported_wp_version" value="6.6"/>
  <config name="testVersion" value="8.1-"/>

  <rule ref="WordPress-Core"/>
  <rule ref="WordPress.WP.I18n">
    <properties>
      <property name="text_domain" type="array">
        <element value="nexuscontent"/>
      </property>
    </properties>
  </rule>
</ruleset>
