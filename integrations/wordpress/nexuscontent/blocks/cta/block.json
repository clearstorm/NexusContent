{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "nexuscontent/cta",
	"version": "0.1.0",
	"title": "Call to Action",
	"category": "nexuscontent",
	"icon": "megaphone",
	"description": "A focused prompt with primary and secondary actions.",
	"textdomain": "nexuscontent",
	"attributes": {
		"section_id": { "type": "string", "default": "" },
		"variant": { "type": "string", "default": "" },
		"heading": { "type": "string", "default": "" },
		"body": { "type": "string", "default": "" },
		"primary_action_label": { "type": "string", "default": "" },
		"primary_action_url": { "type": "string", "default": "" },
		"secondary_action_label": { "type": "string", "default": "" },
		"secondary_action_url": { "type": "string", "default": "" },
		"background_image": { "type": "object", "default": {} },
		"theme": { "type": "string", "default": "" },
		"preview": { "type": "boolean", "default": false }
	},
	"example": { "attributes": { "preview": true } },
	"supports": { "anchor": true, "html": false },
	"editorScript": "nexuscontent-editor",
	"editorStyle": "nexuscontent-editor"
}
