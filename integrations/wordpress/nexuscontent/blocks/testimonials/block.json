{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "nexuscontent/testimonials",
	"version": "0.1.0",
	"title": "Testimonials",
	"category": "nexuscontent",
	"icon": "format-quote",
	"description": "Customer or stakeholder quotations with attribution.",
	"textdomain": "nexuscontent",
	"attributes": {
		"section_id": { "type": "string", "default": "" },
		"variant": { "type": "string", "default": "" },
		"eyebrow": { "type": "string", "default": "" },
		"heading": { "type": "string", "default": "" },
		"items": { "type": "array", "default": [] },
		"theme": { "type": "string", "default": "" },
		"preview": { "type": "boolean", "default": false }
	},
	"example": { "attributes": { "preview": true } },
	"supports": { "anchor": true, "html": false },
	"editorScript": "nexuscontent-editor",
	"editorStyle": "nexuscontent-editor"
}
