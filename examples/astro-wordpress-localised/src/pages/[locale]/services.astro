---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Hero from "../../components/Hero.astro";
import CTA from "../../components/CTA.astro";
import { getPageContent } from "../../nexus";
import { resolveSeo } from "@nexuscontent/core";
import { canonicalUrl, siteSeoDefaults } from "../../app/seo";
import { supportedLocales } from "../../nexus.config";
import type { WordPressExampleContent } from "../../nexus";

export function getStaticPaths() {
  return supportedLocales.map((locale) => ({ params: { locale } }));
}

const { locale = "en" } = Astro.params;
const page = await getPageContent<WordPressExampleContent>("services", { locale });

if (!page) {
  throw new Error(`Required WordPress page "services" was not found for ${locale}.`);
}

const fields = (page.data.fields ?? {}) as Record<string, unknown>;

const hero = (fields.hero ?? {}) as {
  eyebrow?: string;
  heading: string;
  intro: string;
};

const services = (fields.services ?? {}) as {
  heading: string;
  intro?: string;
  items: { title: string; description: string; points: string[] }[];
};

const cta = (fields.cta ?? {}) as {
  heading: string;
  intro: string;
  label: string;
  href: string;
};

const seo = resolveSeo({
  title: page.title ?? "Services",
  seo: { ...page.seo, canonicalUrl: canonicalUrl(`/${locale}/services/`) }
}, siteSeoDefaults);
---

<BaseLayout seo={seo} locale={locale}>
  <Hero {...hero} />

  <section class="section services">
    <h2>{services.heading}</h2>
    {services.intro && <p class="lede">{services.intro}</p>}
    <div class="grid">
      {
        services.items.map((service, index) => (
          <article class="card">
            <span class="num">{index + 1}</span>
            <h3>{service.title}</h3>
            <p>{service.description}</p>
            <ul>
              {service.points.map((point) => (
                <li>{point}</li>
              ))}
            </ul>
          </article>
        ))
      }
    </div>
  </section>

  <CTA {...cta} />

  <style>
    .lede {
      color: var(--muted);
      max-width: 44rem;
    }

    .grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(18rem, 1fr));
      gap: 1.5rem;
      margin-top: 1.5rem;
    }

    .card {
      position: relative;
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 1.5rem;
      background: var(--surface);
      box-shadow: var(--shadow-sm);
    }

    .card h3 {
      margin-top: 0.75rem;
    }

    .card ul {
      margin: 0.75rem 0 0;
      padding-left: 1.1rem;
      color: var(--muted);
    }

    .card li + li {
      margin-top: 0.25rem;
    }

    .num {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 2rem;
      height: 2rem;
      border-radius: 0.5rem;
      background: var(--accent-soft);
      color: var(--accent);
      font-weight: 700;
      font-size: 0.9rem;
    }
  </style>
</BaseLayout>
