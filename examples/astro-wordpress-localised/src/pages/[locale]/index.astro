---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Hero from "../../components/Hero.astro";
import Services from "../../components/Services.astro";
import Testimonials from "../../components/Testimonials.astro";
import CTA from "../../components/CTA.astro";
import { getPageContent } from "../../nexus";
import { resolveSeo } from "@nexuscontent/core";
import { canonicalUrl, siteSeoDefaults } from "../../app/seo";
import { supportedLocales } from "../../nexus.config";
import type { WordPressExampleContent } from "../../nexus";

export function getStaticPaths() {
  return supportedLocales.map((locale) => ({ params: { locale } }));
}

const { locale = "en" } = Astro.params;
const page = await getPageContent<WordPressExampleContent>("home", { locale });

if (!page) {
  throw new Error(`Required WordPress page "home" was not found for ${locale}.`);
}

const fields = (page.data.fields ?? {}) as Record<string, unknown>;

const hero = (fields.hero ?? {}) as {
  eyebrow?: string;
  heading: string;
  intro: string;
  cta?: { label: string; href: string };
};

const services = (fields.services ?? {}) as {
  heading: string;
  intro?: string;
  items: { title: string; description: string }[];
};

const testimonials = (fields.testimonials ?? {}) as {
  heading: string;
  items: { quote: string; author: string }[];
};

const cta = (fields.cta ?? {}) as {
  heading: string;
  intro: string;
  label: string;
  href: string;
};

const seo = resolveSeo({
  title: page.title ?? "NexusContent WordPress Example",
  seo: { ...page.seo, canonicalUrl: canonicalUrl(`/${locale}/`) }
}, siteSeoDefaults);
---

<BaseLayout seo={seo} locale={locale}>
  <Hero {...hero} />
  <Services {...services} />
  <Testimonials {...testimonials} />
  <CTA {...cta} />
</BaseLayout>
