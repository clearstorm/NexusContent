---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { getCollectionContent, getItemContent } from "../../../nexus";
import { resolveSeo } from "@nexuscontent/core";
import { canonicalUrl, siteSeoDefaults } from "../../../app/seo";
import { supportedLocales } from "../../../nexus.config";
import type { WordPressExampleContent } from "../../../nexus";

export async function getStaticPaths() {
  const paths: {
    params: { locale: string; slug: string };
    props: { key: string };
  }[] = [];

  for (const locale of supportedLocales) {
    const posts = await getCollectionContent<WordPressExampleContent>("blog", { locale });
    for (const post of posts) {
      paths.push({
        params: { locale, slug: post.slug ?? post.key },
        props: { key: post.key }
      });
    }
  }

  return paths;
}

const { locale = "en", slug } = Astro.params;
const { key } = Astro.props as { key?: string };

const post = await getItemContent<WordPressExampleContent>("blog", key ?? "", { locale });

if (!post) {
  throw new Error(`Required WordPress post "${key ?? slug}" was not found for ${locale}.`);
}

const postTitle = post.title ?? "Post";
const postUrl = canonicalUrl(`/${locale}/blog/${post.slug ?? post.key}/`);
const seo = resolveSeo({
  title: `${postTitle} - NexusContent WordPress Example`,
  seo: {
    description: post.data.excerpt,
    canonicalUrl: postUrl,
    openGraph: { type: "article" },
    structuredData: [
      {
        "@context": "https://schema.org",
        "@type": "BlogPosting",
        headline: postTitle,
        url: postUrl,
        ...(post.data.publishedAt ? { datePublished: post.data.publishedAt } : {})
      }
    ]
  }
}, siteSeoDefaults);
---

<BaseLayout seo={seo} locale={locale}>
  <article class="post">
    <p class="back">
      <a href={`/${locale}/blog`}>Blog</a>
    </p>
    <h1>{post.title}</h1>
    {post.data.publishedAt && <time>{post.data.publishedAt}</time>}
    {post.data.content && <div class="body wordpress-content" set:html={post.data.content} />}
  </article>

  <style>
    .post {
      max-width: 46rem;
    }

    .back a {
      color: var(--muted);
      text-decoration: none;
      font-size: 0.9rem;
    }

    .back a:hover {
      color: var(--accent);
    }

    .post time {
      display: inline-block;
      margin-top: 0.5rem;
      color: var(--muted);
      font-size: 0.9rem;
    }

    .body {
      margin-top: 2rem;
      font-size: 1.15rem;
      color: var(--muted);
      line-height: 1.8;
    }
  </style>
</BaseLayout>
