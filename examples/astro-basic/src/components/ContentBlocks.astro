---
import type { MediaReference } from "@nexuscontent/core";
import Hero from "./Hero.astro";
import Services from "./Services.astro";
import Testimonials from "./Testimonials.astro";
import RichTextContent from "./RichTextContent.astro";
import ImageGallery from "./ImageGallery.astro";
import CodeSnippet from "./CodeSnippet.astro";

type Block =
  | {
      _type: "hero";
      heading: string;
      intro?: string;
      image?: MediaReference;
      cta?: { label: string; href: string; variant?: string };
    }
  | {
      _type: "servicesList";
      heading: string;
      intro?: string;
      items?: { title: string; description: string; icon?: MediaReference }[];
    }
  | {
      _type: "testimonialsList";
      heading: string;
      items?: { quote: string; author: string; avatar?: MediaReference }[];
    }
  | { _type: "richTextContent"; heading?: string; content: string }
  | { _type: "imageGallery"; heading?: string; images: MediaReference[] }
  | { _type: "codeSnippet"; language: string; code: string; caption?: string };

interface Props {
  blocks: Block[];
}

const { blocks } = Astro.props;
---

{
  blocks.map((block) => {
    switch (block._type) {
      case "hero":
        return (
          <Hero
            heading={block.heading}
            intro={block.intro}
            image={block.image}
            cta={block.cta}
          />
        );
      case "servicesList":
        return (
          <Services
            heading={block.heading}
            intro={block.intro}
            items={block.items}
          />
        );
      case "testimonialsList":
        return (
          <Testimonials heading={block.heading} items={block.items} />
        );
      case "richTextContent":
        return <RichTextContent content={block.content} />;
      case "imageGallery":
        return <ImageGallery heading={block.heading} images={block.images} />;
      case "codeSnippet":
        return (
          <CodeSnippet
            language={block.language}
            code={block.code}
            caption={block.caption}
          />
        );
    }
  })
}