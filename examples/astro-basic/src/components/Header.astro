---
const links = [
  { label: "Home", href: "/" },
  { label: "About", href: "/about" },
  { label: "Blog", href: "/blog" }
];
---

<header>
  <nav>
    <a class="brand" href="/">NexusContent</a>
    <ul>
      {
        links.map((link) => (
          <li>
            <a href={link.href}>{link.label}</a>
          </li>
        ))
      }
    </ul>
  </nav>
  <style>
    header {
      border-bottom: 1px solid var(--border);
      background: #ffffff;
    }

    nav {
      max-width: 68rem;
      margin: 0 auto;
      padding: 1rem 1.5rem;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    .brand {
      font-weight: 700;
      text-decoration: none;
      color: var(--fg);
    }

    ul {
      display: flex;
      gap: 1.25rem;
      list-style: none;
      margin: 0;
      padding: 0;
    }

    a {
      text-decoration: none;
    }
  </style>
</header>
