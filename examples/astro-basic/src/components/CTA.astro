---
import { localizeHref } from "../app/locale";

interface Props {
  locale: string;
  heading: string;
  intro: string;
  label: string;
  href: string;
}

const { locale, heading, intro, label, href } = Astro.props;
---

<section class="cta">
  <h2>{heading}</h2>
  <p>{intro}</p>
  <a class="btn btn-primary" href={localizeHref(locale, href)}>
    {label}
  </a>
  <style>
    .cta {
      margin-top: 3.5rem;
      padding: 2.75rem 2.5rem;
      text-align: center;
      border: 1px solid var(--border);
      border-radius: var(--radius-lg);
      background: linear-gradient(135deg, var(--accent-soft), #faf5ff);
    }

    .cta h2 {
      margin-top: 0;
    }

    .cta p {
      color: var(--muted);
      max-width: 36rem;
      margin: 0 auto 1.5rem;
    }
  </style>
</section>
