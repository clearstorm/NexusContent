---
interface Item {
  quote: string;
  author: string;
  avatar?: {
    src: string;
    alt?: string;
  };
}

interface Props {
  heading: string;
  items: Item[];
}

const { heading, items } = Astro.props;
---

<section class="section testimonials">
  <h2>{heading}</h2>
  <div class="grid">
    {
      items.map((item) => (
        <blockquote class="card">
          {item.avatar?.src && (
            <img
              class="avatar"
              src={item.avatar.src}
              alt={item.avatar.alt ?? ""}
              width={48}
              height={48}
            />
          )}
          <p class="quote">"{item.quote}"</p>
          <footer>— {item.author}</footer>
        </blockquote>
      ))
    }
  </div>
  <style>
    .grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(18rem, 1fr));
      gap: 1.5rem;
      margin-top: 1.5rem;
    }

    .card {
      margin: 0;
      border: 1px solid var(--border);
      border-left: 4px solid var(--accent);
      border-radius: var(--radius);
      padding: 1.5rem;
      background: var(--surface);
      box-shadow: var(--shadow-sm);
    }

    .quote {
      margin: 0 0 0.75rem;
      color: var(--fg);
    }

    .card footer {
      color: var(--muted);
      font-size: 0.9rem;
    }

    .card .avatar {
      display: block;
      margin-bottom: 0.75rem;
      border-radius: 50%;
    }
  </style>
</section>