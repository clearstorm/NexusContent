---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import NexusSeo from "../components/NexusSeo.astro";
import { nexus } from "../nexus";
import type { SeoData } from "@nexuscontent/core";
import "../styles/global.css";

interface Props {
  seo: SeoData;
}

const { seo } = Astro.props;
const lang = "en";

const navigation = await nexus.getNavigation("primary");
const site = await nexus.getSettings("site");

if (!navigation) {
  throw new Error(`Required navigation "primary" was not found.`);
}

if (!site) {
  throw new Error(`Required settings "site" was not found.`);
}
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <NexusSeo seo={seo} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <Header links={navigation.items} />
    <main>
      <slot />
    </main>
    <Footer site={site.data} />
  </body>
</html>
