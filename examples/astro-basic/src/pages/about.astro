---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import RichTextContent from "../components/RichTextContent.astro";
import { nexus } from "../nexus";
import { canonicalUrl } from "../app/seo";

const page = await nexus.getPage("about");

if (!page) {
  throw new Error(`Required content "about" was not found.`);
}

// The about hero image reference carries an explicit "remote" provider, so
// resolveFields validates the absolute http(s) URL through the remote media
// provider.
const { hero, mission, story, principles } =
  await nexus.media.resolveFields(page.data);

const seo = await nexus.resolvePageSeo({
  title: page.title ?? "About",
  seo: { ...page.seo, canonicalUrl: canonicalUrl("/about/") }
});
---

<BaseLayout seo={seo}>
  {hero && <Hero {...hero} />}
  {mission && <RichTextContent {...mission} />}
  {story && <RichTextContent {...story} />}
  {principles && <RichTextContent {...principles} />}
</BaseLayout>