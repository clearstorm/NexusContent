---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import RichTextContent from "../components/RichTextContent.astro";
import { nexus } from "../nexus";
import { resolveSeo } from "@nexuscontent/core";
import { canonicalUrl, siteSeoDefaults } from "../app/seo";
import { resolveHero } from "../app/media";

const page = await nexus.getPage("about");

if (!page) {
  throw new Error(`Required content "about" was not found.`);
}

// The about hero image reference carries an explicit "remote" provider, so it
// validates the absolute http(s) URL through the remote media provider.
const hero = await resolveHero(nexus, page.data.hero);
const { mission, story, principles } = page.data;

const seo = resolveSeo({
  title: page.title ?? "About",
  seo: { ...page.seo, canonicalUrl: canonicalUrl("/about/") }
}, siteSeoDefaults);
---

<BaseLayout seo={seo}>
  {hero && <Hero {...hero} />}
  {mission && <RichTextContent {...mission} />}
  {story && <RichTextContent {...story} />}
  {principles && <RichTextContent {...principles} />}
</BaseLayout>