---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getPageContent } from "../nexus";

const page = await getPageContent("about");

if (!page) {
  throw new Error('Required content "about" was not found.');
}

const story = page.data.story as { heading: string; content: string };
const values = page.data.values as { heading: string; items: string[] };
---

<BaseLayout title={page.title ?? "About"} description={page.seo?.description}>
  <section class="story">
    <h1>{story.heading}</h1>
    <p>{story.content}</p>
  </section>

  <section class="values">
    <h2>{values.heading}</h2>
    <ul>
      {values.items.map((item) => <li>{item}</li>)}
    </ul>
  </section>

  <style>
    .story p {
      font-size: 1.15rem;
      color: var(--muted);
      max-width: 44rem;
    }

    .values ul {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
      gap: 1rem;
      list-style: none;
      padding: 0;
    }

    .values li {
      border: 1px solid var(--border);
      border-radius: 0.75rem;
      padding: 1rem 1.25rem;
      background: #ffffff;
    }
  </style>
</BaseLayout>
