---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import CTA from "../components/CTA.astro";
import { nexus } from "../nexus";
import { resolveSeo } from "@nexuscontent/core";
import { canonicalUrl, siteSeoDefaults } from "../app/seo";

const page = await nexus.getPage("about");

if (!page) {
  throw new Error(`Required content "about" was not found.`);
}

// The field-level "remote" override was added to this media reference during
// schema validation, so the remote provider validates the absolute URL.
const heroImage = await nexus.media.resolve(page.data.heroImage);
const { hero, mission, story, values, cta } = page.data;

const seo = resolveSeo({
  title: page.title ?? "About",
  seo: { ...page.seo, canonicalUrl: canonicalUrl("/about/") }
}, siteSeoDefaults);
---

<BaseLayout seo={seo}>
  <Hero {...hero} image={heroImage ?? undefined} />

  <section class="section mission">
    <h2>{mission.heading}</h2>
    <p>{mission.content}</p>
  </section>

  <section class="section story">
    <h2>{story.heading}</h2>
    <p>{story.content}</p>
  </section>

  <section class="section values">
    <h2>{values.heading}</h2>
    <ul>
      {values.items.map((item) => (
        <li>{item}</li>
      ))}
    </ul>
  </section>

  <CTA {...cta} />

  <style>
    .mission p,
    .story p {
      font-size: 1.1rem;
      color: var(--muted);
      max-width: 44rem;
    }

    .values ul {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
      gap: 1rem;
      list-style: none;
      padding: 0;
    }

    .values li {
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 1rem 1.25rem;
      background: var(--surface);
      box-shadow: var(--shadow-sm);
    }
  </style>
</BaseLayout>
