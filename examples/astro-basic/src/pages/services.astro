---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import Services from "../components/Services.astro";
import RichTextContent from "../components/RichTextContent.astro";
import { nexus } from "../nexus";
import { canonicalUrl } from "../app/seo";

const page = await nexus.getPage("services");

if (!page) {
  throw new Error(`Required content "services" was not found.`);
}

const { hero, servicesList, richTextContent } =
  await nexus.media.resolveFields(page.data);

const seo = await nexus.resolvePageSeo({
  title: page.title ?? "Services",
  seo: { ...page.seo, canonicalUrl: canonicalUrl("/services/") }
});
---

<BaseLayout seo={seo}>
  {hero && <Hero {...hero} />}
  {servicesList && <Services {...servicesList} />}
  {richTextContent && <RichTextContent {...richTextContent} />}
</BaseLayout>