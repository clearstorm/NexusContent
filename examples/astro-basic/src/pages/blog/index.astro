---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PostCard from "../../components/PostCard.astro";
import { getCollectionContent } from "../../nexus";

const posts = await getCollectionContent("blog");
---

<BaseLayout title="Blog - NexusContent Example">
  <h1>Blog</h1>
  <p>Posts from the Git content repository.</p>
  <div class="posts">
    {
      posts.map((post) => (
        <PostCard
          title={post.title}
          slug={post.slug ?? post.key}
          date={(post.data as { date?: string }).date}
          excerpt={(post.data as { excerpt?: string }).excerpt}
        />
      ))
    }
  </div>
  <style>
    .posts {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(18rem, 1fr));
      gap: 1.5rem;
      margin-top: 1.5rem;
    }
  </style>
</BaseLayout>
