---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ContentBlocks from "../../components/ContentBlocks.astro";
import { nexus } from "../../nexus";
import { resolveSeo } from "@nexuscontent/core";
import { canonicalUrl, siteSeoDefaults } from "../../app/seo";
import { resolveBlocks } from "../../app/media";

export async function getStaticPaths() {
  const posts = await nexus.getCollection("blog");
  return posts.map((post) => ({
      params: { slug: post.slug ?? post.key },
      props: { key: post.key }
    }));
}

const { slug } = Astro.params;
const { key } = Astro.props as { key?: string };

const post = await nexus.getItem("blog", key ?? "");

if (!post) {
  throw new Error(`Required content "${key ?? slug}" was not found.`);
}

const { date, excerpt } = post.data;
const blocks = await resolveBlocks(nexus, post.data.body);
const postTitle = post.title ?? "Post";
const postUrl = canonicalUrl(`/blog/${post.slug ?? post.key}/`);
const seo = resolveSeo({
  title: `${postTitle} - NexusContent Example`,
  seo: {
    description: excerpt,
    canonicalUrl: postUrl,
    openGraph: { type: "article" },
    structuredData: [
      {
        "@context": "https://schema.org",
        "@type": "BlogPosting",
        headline: postTitle,
        url: postUrl,
        ...(date ? { datePublished: date } : {})
      }
    ]
  }
}, siteSeoDefaults);
---

<BaseLayout seo={seo}>
  <article class="post">
    <p class="back">
      <a href="/blog">← Blog</a>
    </p>
    <h1>{post.title}</h1>
    {date && <time>{date}</time>}
    <ContentBlocks blocks={blocks} />
  </article>

  <style>
    .post {
      max-width: 46rem;
    }

    .back a {
      color: var(--muted);
      text-decoration: none;
      font-size: 0.9rem;
    }

    .back a:hover {
      color: var(--accent);
    }

    .post h1 {
      margin-bottom: 0.5rem;
    }

    .post time {
      display: inline-block;
      margin-bottom: 1rem;
      color: var(--muted);
      font-size: 0.9rem;
    }
  </style>
</BaseLayout>