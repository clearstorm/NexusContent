---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import RichTextContent from "../components/RichTextContent.astro";
import ContactDetails from "../components/ContactDetails.astro";
import { nexus } from "../nexus";
import { canonicalUrl } from "../app/seo";
import { resolveHero } from "../app/media";

const page = await nexus.getPage("contact");

if (!page) {
  throw new Error(`Required content "contact" was not found.`);
}

// Contact details live in the site settings, so every page can reuse them.
const settings = await nexus.getSettings("site");

if (!settings) {
  throw new Error(`Required settings "site" was not found.`);
}

const hero = await resolveHero(nexus, page.data.hero);
const { introduction } = page.data;
const { contactDetails } = settings.data;

const seo = await nexus.resolvePageSeo({
  title: page.title ?? "Contact",
  seo: { ...page.seo, canonicalUrl: canonicalUrl("/contact/") }
});
---

<BaseLayout seo={seo}>
  {hero && <Hero {...hero} />}
  {introduction && <RichTextContent {...introduction} />}
  {contactDetails && <ContactDetails {...contactDetails} />}
</BaseLayout>