---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import Services from "../components/Services.astro";
import Testimonials from "../components/Testimonials.astro";
import CTA from "../components/CTA.astro";
import { getPageContent } from "../nexus";

const page = await getPageContent("home");

if (!page) {
  throw new Error(`Required content "home" was not found.`);
}

const hero = page.data.hero as {
  eyebrow?: string;
  heading: string;
  intro: string;
  cta?: { label: string; href: string };
};

const services = page.data.services as {
  heading: string;
  intro?: string;
  items: { title: string; description: string }[];
};

const testimonials = page.data.testimonials as {
  heading: string;
  items: { quote: string; author: string }[];
};

const cta = page.data.cta as {
  heading: string;
  intro: string;
  label: string;
  href: string;
};
---

<BaseLayout
  title={page.title ?? "NexusContent Example"}
  description={page.seo?.description}
>
  <Hero {...hero} />
  <Services {...services} />
  <Testimonials {...testimonials} />
  <CTA {...cta} />
</BaseLayout>
