---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import Services from "../components/Services.astro";
import Testimonials from "../components/Testimonials.astro";
import RichTextContent from "../components/RichTextContent.astro";
import { nexus } from "../nexus";
import { canonicalUrl } from "../app/seo";

const page = await nexus.getPage("home");

if (!page) {
  throw new Error(`Required content "home" was not found.`);
}

// resolveFields() recursively resolves every authored media reference in the
// page data before the components render. The home hero image has no provider,
// so it resolves through the configured default "local" media provider.
const { hero, servicesList, testimonialsList, richTextContent } =
  await nexus.media.resolveFields(page.data);

const seo = await nexus.resolvePageSeo({
  title: page.title ?? "Home",
  seo: { ...page.seo, canonicalUrl: canonicalUrl("/") }
});
---

<BaseLayout seo={seo}>
  {hero && <Hero {...hero} />}
  {servicesList && <Services {...servicesList} />}
  {testimonialsList && <Testimonials {...testimonialsList} />}
  {richTextContent && <RichTextContent {...richTextContent} />}
</BaseLayout>