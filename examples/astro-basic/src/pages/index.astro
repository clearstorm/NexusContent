---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import Services from "../components/Services.astro";
import Testimonials from "../components/Testimonials.astro";
import RichTextContent from "../components/RichTextContent.astro";
import { nexus } from "../nexus";
import { resolveSeo } from "@nexuscontent/core";
import { canonicalUrl, siteSeoDefaults } from "../app/seo";
import { resolveHero, resolveServices, resolveTestimonials } from "../app/media";

const page = await nexus.getPage("home");

if (!page) {
  throw new Error(`Required content "home" was not found.`);
}

// Named fields carry media as `MediaReference` values, resolved here before
// components render. The home hero image has no provider, so it resolves
// through the configured default "local" media provider.
const hero = await resolveHero(nexus, page.data.hero);
const services = await resolveServices(nexus, page.data.servicesList);
const testimonials = await resolveTestimonials(nexus, page.data.testimonialsList);
const { richTextContent } = page.data;

const seo = resolveSeo({
  title: page.title ?? "NexusContent Example",
  seo: { ...page.seo, canonicalUrl: canonicalUrl("/") }
}, siteSeoDefaults);
---

<BaseLayout seo={seo}>
  {hero && <Hero {...hero} />}
  {services && <Services {...services} />}
  {testimonials && <Testimonials {...testimonials} />}
  {richTextContent && <RichTextContent {...richTextContent} />}
</BaseLayout>