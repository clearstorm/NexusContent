---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import Services from "../components/Services.astro";
import Testimonials from "../components/Testimonials.astro";
import CTA from "../components/CTA.astro";
import { nexus } from "../nexus";
import { resolveSeo } from "@nexuscontent/core";
import { canonicalUrl, siteSeoDefaults } from "../app/seo";

const page = await nexus.getPage("home");

if (!page) {
  throw new Error(`Required content "home" was not found.`);
}

// Explicit media resolution: home.heroImage carries no provider, so it
// resolves through the configured default "local" media provider.
const heroImage = await nexus.media.resolve(page.data.heroImage);
const { hero, services, testimonials, cta } = page.data;

const seo = resolveSeo({
  title: page.title ?? "NexusContent Example",
  seo: { ...page.seo, canonicalUrl: canonicalUrl("/") }
}, siteSeoDefaults);
---

<BaseLayout seo={seo}>
  <Hero {...hero} image={heroImage ?? undefined} />
  <Services {...services} />
  <Testimonials {...testimonials} />
  <CTA {...cta} />
</BaseLayout>
