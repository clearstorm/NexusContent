# Astro basic example environment
#
# Path to the content repository used by the Git content provider.
# Relative to this directory (examples/astro-basic).
NEXUS_GIT_CONTENT_PATH=content

# Public canonical base URL for SEO. Falls back to https://nexuscontent.dev
# when unset (for example in CI), so builds stay deterministic.
PUBLIC_SITE_URL=https://nexuscontent.dev
