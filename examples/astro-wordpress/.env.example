# WordPress REST API root. HTTPS is recommended outside local development.
# Must include /wp-json/ for companion plugin auto-detection.
WORDPRESS_API_URL=https://wordpress.example.com/wp-json/wp/v2

# WordPress authentication credentials for accessing the REST API.
# Create an Application Password under Users > Your Profile > Application Passwords.
WORDPRESS_USERNAME=your-wordpress-username
WORDPRESS_APP_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx

# The provider apiStrategy is configured in nexus.config.ts:
#   "auto"      — tries companion plugin first, falls back to standard REST
#   "companion" — requires the NexusContent companion plugin
#   "core"      — standard REST only (0.2.0 behaviour)

# Never expose API tokens or other secrets in client-side code or public environment variables.
