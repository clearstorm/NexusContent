---
import BaseLayout from "../layouts/BaseLayout.astro";
import CTA from "../components/CTA.astro";
import Faq from "../components/Faq.astro";
import Features from "../components/Features.astro";
import Hero from "../components/Hero.astro";
import type { Props as CtaProps } from "../components/CTA.astro";
import type { Props as FaqProps } from "../components/Faq.astro";
import type { Props as FeaturesProps } from "../components/Features.astro";
import type { Props as HeroProps } from "../components/Hero.astro";
import { nexus } from "../nexus";
import { canonicalUrl } from "../app/seo";


export interface ServicesData {
  hero?: HeroProps;
  features?: FeaturesProps;
  faq?: FaqProps;
  cta?: CtaProps;
}

const page = await nexus.getPage("services");

if (!page) {
  throw new Error(`Required content "services" was not found.`);
}

const services = (await nexus.media.resolveFields(page.sections)) as ServicesData;

const seo = await nexus.resolvePageSeo({
  title: page.title ?? "Services",
  seo: { ...page.seo, canonicalUrl: canonicalUrl("/services/") }
});
---

<BaseLayout seo={seo}>
  {services.hero && <Hero {...services.hero} />}
  {services.features && <Features {...services.features} />}
  {services.faq && <Faq {...services.faq} />}
  {services.cta && <CTA {...services.cta} />}
</BaseLayout>