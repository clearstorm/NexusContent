---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import CTA from "../components/CTA.astro";
import { nexus } from "../nexus";
import { resolveSeo } from "@nexuscontent/core";
import { canonicalUrl, siteSeoDefaults } from "../app/seo";

const page = await nexus.getPage("contact");

if (!page) {
  throw new Error(`Required WordPress page "contact" was not found.`);
}

const { hero } = page.data;
const { contact } = page.data;
const { cta } = page.data;

const seo = resolveSeo({
  title: page.title ?? "Contact",
  seo: { ...page.seo, canonicalUrl: canonicalUrl("/contact/") }
}, siteSeoDefaults);
---

<BaseLayout seo={seo}>
  <Hero {...hero} />

  <section class="section details">
    <h2>{contact.heading}</h2>
    <div class="grid">
      {
        contact.items.map((detail) => (
          <article class="card">
            <h3>{detail.label}</h3>
            {detail.href ? (
              <a href={detail.href}>{detail.value}</a>
            ) : (
              <p>{detail.value}</p>
            )}
          </article>
        ))
      }
    </div>
  </section>

  {cta && <CTA {...cta} />}

  <style>
    .grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
      gap: 1.5rem;
      margin-top: 1.5rem;
    }

    .card {
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 1.5rem;
      background: var(--surface);
      box-shadow: var(--shadow-sm);
    }

    .card h3 {
      margin-top: 0;
    }

    .card p {
      margin: 0;
      color: var(--muted);
    }

    .card a {
      font-weight: 600;
      word-break: break-word;
    }
  </style>
</BaseLayout>