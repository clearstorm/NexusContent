---
export const prerender = false;

import BaseLayout from "../layouts/BaseLayout.astro";
import PostSections from "../components/PostSections.astro";
import WordpressContent from "../app/WordpressContent.astro";
import {
  companionPageResponseSchema,
  normalizeCompanionPage,
  resolveSeo
} from "@nexuscontent/core";
import { canonicalUrl, siteSeoDefaults } from "../app/seo";
import { gutenbergStyleSheets } from "../app/gutenberg";
import { nexus } from "../nexus";

// Draft/scheduled preview route. The WordPress companion plugin mints a
// short-lived token bound to a single post ID; the Gutenberg "Open frontend
// preview" button opens this route with `?token=...&id=...`. The token is the
// auth — no session is required — and it expires within minutes, so it never
// leaks into production builds or indexes. The route is on-demand
// (`prerender = false` under hybrid output): reading the query string requires
// per-request rendering, which a static page cannot do.
const token = Astro.url.searchParams.get("token") ?? "";
const id = Astro.url.searchParams.get("id") ?? "";

if (!token || !id) {
  Astro.response.status = 400;
}

// Resolve the companion namespace (`nexuscontent/v1`) from the configured
// WordPress REST API root, which includes `.../wp-json/wp/v2`.
const apiRoot = import.meta.env.WORDPRESS_API_URL as string | undefined;
const wpJsonIndex = apiRoot?.indexOf("/wp-json/wp/v2");
const apiBase =
  apiRoot && wpJsonIndex !== undefined && wpJsonIndex >= 0
    ? apiRoot.slice(0, wpJsonIndex)
    : undefined;

let preview:
  | {
      title?: string;
      status?: string;
      sections?: unknown[];
      content?: string;
      excerpt?: string;
      modifiedAt?: string;
    }
  | undefined = undefined;
let error: string | undefined = undefined;

if (apiBase && token && id) {
  const url = `${apiBase}/wp-json/nexuscontent/v1/preview/${encodeURIComponent(token)}/${encodeURIComponent(id)}`;
  try {
    const res = await fetch(url);
    if (res.ok) {
      // The preview endpoint serves the same contract-v1 page wire as the
      // companion pages/posts routes, so reuse the provider's tested
      // normalization exactly as companion retrieval does: media `url` becomes
      // `MediaAsset.src`, sections flatten to the canonical `{ type, data }`
      // shape, and `data.content` keeps the raw-HTML fallback. This keeps the
      // preview indistinguishable from a published post for consumer
      // components.
      const parsed = companionPageResponseSchema.safeParse(await res.json());
      if (parsed.success) {
        const page = normalizeCompanionPage(parsed.data.data, id);
        preview = {
          title: page.title,
          status: page.status,
          sections: page.sectionsList,
          content: typeof page.data.content === "string" ? page.data.content : undefined,
          excerpt: page.excerpt,
          modifiedAt: page.modifiedAt
        };
      } else {
        error = "The preview service returned an invalid response.";
      }
    } else if (res.status === 401) {
      error = "This preview link has expired or is invalid.";
    } else {
      error = "The preview could not be loaded.";
    }
  } catch {
    error = "The preview service could not be reached.";
  }
} else if (token && id && apiRoot) {
  error = "WORDPRESS_API_URL must end in /wp-json/wp/v2 to resolve the preview endpoint.";
} else if (token && id) {
  error = "WORDPRESS_API_URL is required to load a preview.";
}

const data = (await nexus.media.resolveFields(preview ?? {})) as {
  sections?: { type?: string; _type?: string; data?: Record<string, unknown> }[];
  content?: string;
  excerpt?: string;
};

const previewTitle = preview?.title ?? "Preview";
const seo = resolveSeo(
  {
    title: `${previewTitle} - Preview`,
    seo: { robots: { index: false, follow: false } }
  },
  siteSeoDefaults
);
---

<BaseLayout seo={seo} styles={gutenbergStyleSheets}>
  <WordpressContent />
  <article class="preview">
    <p class="back">
      <a href="/">← Home</a>
    </p>
    {error ? (
      <div class="notice">{error}</div>
    ) : preview ? (
      <>
        <header>
          <h1>{previewTitle}</h1>
          {preview.status && preview.status !== "published" && (
            <span class="status">{preview.status}</span>
          )}
          {data.excerpt && <p class="excerpt">{data.excerpt}</p>}
        </header>

        {data.sections && data.sections.length > 0 ? (
          <div class="sections">
            <PostSections sections={data.sections} />
          </div>
        ) : data.content ? (
          <div class="body wordpress-content" set:html={data.content} />
        ) : (
          <p class="empty">This content has no body yet.</p>
        )}
      </>
    ) : (
      <div class="notice">Missing preview token or content id.</div>
    )}
    {(!preview || error) && (
      <details class="diagnostics">
        <summary>Preview diagnostics</summary>
        <ul>
          <li>token present: {token ? "yes" : "no"}</li>
          <li>id present: {id ? "yes" : "no"}</li>
          <li>API base: {apiBase ?? "not detected (WORDPRESS_API_URL must end in /wp-json/wp/v2)"}</li>
        </ul>
      </details>
    )}
  </article>

  <style>
    .preview {
      max-width: 52rem;
    }

    .back a {
      color: var(--muted);
      text-decoration: none;
      font-size: 0.9rem;
    }

    .back a:hover {
      color: var(--accent);
    }

    .status {
      display: inline-block;
      margin-top: 0.5rem;
      padding: 0.2rem 0.6rem;
      border-radius: var(--radius);
      background: var(--accent-soft);
      color: var(--accent);
      font-size: 0.8rem;
      text-transform: uppercase;
      letter-spacing: 0.03em;
    }

    .excerpt {
      margin-top: 0.75rem;
      color: var(--muted);
    }

    .body,
    .empty,
    .notice {
      margin-top: 2rem;
      font-size: 1.15rem;
      color: var(--muted);
      line-height: 1.8;
    }

    .notice {
      padding: 1rem;
      border: 1px solid var(--border);
      border-radius: var(--radius);
    }

    .diagnostics {
      margin-top: 1rem;
      padding: 0.75rem 1rem;
      border: 1px dashed var(--border);
      border-radius: var(--radius);
      font-size: 0.85rem;
      color: var(--muted);
    }

    .diagnostics summary {
      cursor: pointer;
      font-weight: 600;
    }

    .diagnostics ul {
      margin: 0.5rem 0 0;
      padding-left: 1.25rem;
    }

    .sections {
      margin-top: 2.5rem;
    }
  </style>
</BaseLayout>
