---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PostCard from "../../components/PostCard.astro";
import { nexus } from "../../nexus";
import { resolveSeo } from "@nexuscontent/core";
import { canonicalUrl, siteSeoDefaults } from "../../app/seo";
import { resolveImage } from "../../app/media";

const posts = await nexus.getCollection("blog");

const cards = await Promise.all(
  posts.map(async (post) => {
    const image = await resolveImage(nexus, post.data.featuredImage as never);
    return { ...post, image };
  })
);

const intro = "Posts from the Git content repository.";
const seo = resolveSeo({
  title: "Blog - NexusContent WordPress Example",
  seo: { description: intro, canonicalUrl: canonicalUrl("/blog/") }
}, siteSeoDefaults);
---

<BaseLayout seo={seo}>
  <header class="page-head">
    <p class="eyebrow">Blog</p>
    <h1>{intro}</h1>
  </header>

  <div class="posts">
    {
      cards.map((post) => (
        <PostCard
          title={post.title}
          slug={post.slug ?? post.key}
          date={post.data.publishedAt}
          excerpt={post.data.excerpt}
          image={post.image}
        />
      ))
    }
  </div>

  <style>
    .page-head h1 {
      margin-top: 0.25rem;
      font-size: clamp(1.75rem, 4vw, 2.5rem);
    }

    .posts {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(18rem, 1fr));
      gap: 1.5rem;
      margin-top: 1.5rem;
    }
  </style>
</BaseLayout>