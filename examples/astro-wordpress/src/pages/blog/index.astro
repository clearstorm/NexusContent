---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PostCard from "../../components/PostCard.astro";
import { getCollectionContent } from "../../nexus";
import { resolveSeo } from "@nexuscontent/core";
import { canonicalUrl, siteSeoDefaults } from "../../app/seo";
import type { WordPressExampleContent } from "../../nexus";

const posts = await getCollectionContent<WordPressExampleContent>("blog");

const intro = "Posts from the WordPress content source.";
const seo = resolveSeo({
  title: "Blog - NexusContent WordPress Example",
  seo: { description: intro, canonicalUrl: canonicalUrl("/blog/") }
}, siteSeoDefaults);
---

<BaseLayout seo={seo}>
  <header class="page-head">
    <p class="eyebrow">Blog</p>
    <h1>{intro}</h1>
  </header>

  <div class="posts">
    {
      posts.map((post) => (
        <PostCard
          title={post.title}
          slug={post.slug ?? post.key}
          date={(post.data as WordPressExampleContent).publishedAt}
          excerpt={post.excerpt ?? (post.data as WordPressExampleContent).excerpt}
        />
      ))
    }
  </div>

  <style>
    .page-head h1 {
      margin-top: 0.25rem;
      font-size: clamp(1.75rem, 4vw, 2.5rem);
    }

    .posts {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(18rem, 1fr));
      gap: 1.5rem;
      margin-top: 1.5rem;
    }
  </style>
</BaseLayout>
