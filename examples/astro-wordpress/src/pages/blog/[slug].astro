---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PostSections from "../../components/PostSections.astro";
import { nexus } from "../../nexus";
import { resolveSeo } from "@nexuscontent/core";
import { canonicalUrl, siteSeoDefaults } from "../../app/seo";
import { gutenbergStyleSheets } from "../../app/gutenberg";
import { resolveMediaFields } from "../../app/media";

export async function getStaticPaths() {
  const posts = await nexus.getCollection("blog");
  return posts.map((post) => ({
    params: { slug: post.slug ?? post.key },
    props: { key: post.key }
  }));
}

const { slug } = Astro.params;
const { key } = Astro.props as { key?: string };

const post = await nexus.getItem("blog", key ?? "");

if (!post) {
  throw new Error(`Required post "${key ?? slug}" was not found.`);
}

interface PostData {
  excerpt?: string;
  content?: string;
  publishedAt?: string;
  sections?: { type?: string; _type?: string; data?: Record<string, unknown> }[];
}

const data = (await resolveMediaFields(nexus, post.data)) as PostData;

const postTitle = post.title ?? "Post";
const postUrl = canonicalUrl(`/blog/${post.slug ?? post.key}/`);
const excerpt = data.excerpt;
const seo = resolveSeo({
  title: `${postTitle} - NexusContent WordPress Example`,
  seo: {
    description: excerpt,
    canonicalUrl: postUrl,
    openGraph: { type: "article" },
    structuredData: [
      {
        "@context": "https://schema.org",
        "@type": "BlogPosting",
        headline: postTitle,
        url: postUrl,
        ...(data.publishedAt ? { datePublished: data.publishedAt } : {})
      }
    ]
  }
}, siteSeoDefaults);
---

<BaseLayout seo={seo} styles={gutenbergStyleSheets}>
  <article class="post">
    <p class="back">
      <a href="/blog">← Blog</a>
    </p>
    <header>
      <h1>{post.title}</h1>
      {data.publishedAt && <time>{data.publishedAt}</time>}
      
    </header>

    <!-- WordPress posts outside the known `core/*` block set produce no
    sections. Their rendered content is external HTML owned by the consumer,
    so it is inserted directly and styled below. -->
    {data.sections && data.sections.length > 0 ? (
      <div class="sections">
        <PostSections sections={data.sections} />
      </div>
    ) : data.content ? (
      <div class="body wordpress-content" set:html={data.content} />
    ) : (
      <p class="empty">This post has no body content yet.</p>
    )}
  </article>

  <style>
    .post {
      max-width: 52rem;
    }

    .back a {
      color: var(--muted);
      text-decoration: none;
      font-size: 0.9rem;
    }

    .back a:hover {
      color: var(--accent);
    }

    .post time {
      display: inline-block;
      margin-top: 0.5rem;
      color: var(--muted);
      font-size: 0.9rem;
    }

    .excerpt {
      margin-top: 0.75rem;
      color: var(--muted);
      font-size: 1.05rem;
      line-height: 1.6;
    }

    .body,
    .empty {
      margin-top: 2rem;
      font-size: 1.15rem;
      color: var(--muted);
      line-height: 1.8;
    }

    /* Consumer-owned prose layer for raw WordPress content. The vendored
    Gutenberg block-library CSS styles the .wp-block-* classes; these rules
    cover what Gutenberg leaves to the theme. */
    .wordpress-content :global(h2),
    .wordpress-content :global(h3) {
      margin: 2rem 0 0.5rem;
      line-height: 1.2;
      color: var(--fg);
    }

    .wordpress-content :global(p) {
      margin: 0 0 1rem;
    }

    .wordpress-content :global(img) {
      max-width: 100%;
      height: auto;
      border-radius: var(--radius);
    }

    .wordpress-content :global(figure) {
      margin: 1.5rem 0;
    }

    .wordpress-content :global(figcaption) {
      margin-top: 0.5rem;
      font-size: 0.9rem;
      color: var(--muted);
      text-align: center;
    }

    .wordpress-content :global(video),
    .wordpress-content :global(iframe),
    .wordpress-content :global(embed),
    .wordpress-content :global(audio) {
      max-width: 100%;
    }

    .wordpress-content :global(ul),
    .wordpress-content :global(ol) {
      margin: 0 0 1rem;
      padding-left: 1.5rem;
    }

    .wordpress-content :global(blockquote) {
      margin: 1.5rem 0;
      padding: 0.25rem 0 0.25rem 1rem;
      border-left: 4px solid var(--accent);
      color: var(--muted);
    }

    .wordpress-content :global(a) {
      color: var(--accent);
    }

    .wordpress-content :global(code) {
      font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
      font-size: 0.9em;
      background: var(--accent-soft);
      padding: 0.15em 0.4em;
      border-radius: 0.25rem;
    }

    .wordpress-content :global(pre) {
      margin: 1.5rem 0;
      padding: 1rem;
      overflow-x: auto;
      background: var(--fg);
      color: #fafaf9;
      border-radius: var(--radius);
    }

    .wordpress-content :global(pre code) {
      background: transparent;
      padding: 0;
    }

    .wordpress-content :global(hr) {
      border: 0;
      border-top: 1px solid var(--border);
      margin: 2rem 0;
    }

    .wordpress-content :global(table) {
      width: 100%;
      border-collapse: collapse;
    }

    .wordpress-content :global(thead th) {
      text-align: left;
      border-bottom: 2px solid var(--border);
      padding: 0.5rem;
    }

    .wordpress-content :global(td),
    .wordpress-content :global(tbody th) {
      border-bottom: 1px solid var(--border);
      padding: 0.5rem;
      vertical-align: top;
    }

    /* Gutenberg align classes stay inside the 52rem post column. */
    .wordpress-content :global(.alignwide),
    .wordpress-content :global(.alignfull) {
      width: 100%;
    }

    .wordpress-content :global(.nexuscontent-section__gallery) {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr));
      gap: 1rem;
      margin-top: 1.5rem;
    }

    .wordpress-content :global(.nexuscontent-section__image) {
      width: 100%;
      height: 12rem;
      object-fit: cover;
      border-radius: var(--radius);
    }

    .sections {
      margin-top: 2.5rem;
    }
  </style>
</BaseLayout>