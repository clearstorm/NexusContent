---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { nexus } from "../../nexus";
import { resolveSeo } from "@nexuscontent/core";
import { canonicalUrl, siteSeoDefaults } from "../../app/seo";

export async function getStaticPaths() {
  const posts = await nexus.getCollection("blog");
  return posts.map((post) => ({
    params: { slug: post.slug ?? post.key },
    props: { key: post.key }
  }));
}

const { slug } = Astro.params;
const { key } = Astro.props as { key?: string };

const post = await nexus.getItem("blog", key ?? "");

if (!post) {
  throw new Error(`Required WordPress post "${key ?? slug}" was not found.`);
}

const postTitle = post.title ?? "Post";
const postUrl = canonicalUrl(`/blog/${post.slug ?? post.key}/`);
const excerpt = post.data.excerpt;
const seo = resolveSeo({
  title: `${postTitle} - NexusContent WordPress Example`,
  seo: {
    description: excerpt,
    canonicalUrl: postUrl,
    openGraph: { type: "article" },
    structuredData: [
      {
        "@context": "https://schema.org",
        "@type": "BlogPosting",
        headline: postTitle,
        url: postUrl,
        ...(post.data.publishedAt ? { datePublished: post.data.publishedAt } : {})
      }
    ]
  }
}, siteSeoDefaults);
---

<BaseLayout seo={seo}>
  <article class="post">
    <p class="back">
      <a href="/blog">← Blog</a>
    </p>
    <h1>{post.title}</h1>
    {post.data.publishedAt && <time>{post.data.publishedAt}</time>}
    {excerpt && <p class="excerpt">{excerpt}</p>}
    <div class="body wordpress-content" set:html={post.data.content} />
  </article>

  <style>
    .post {
      max-width: 46rem;
    }

    .back a {
      color: var(--muted);
      text-decoration: none;
      font-size: 0.9rem;
    }

    .back a:hover {
      color: var(--accent);
    }

    .post time {
      display: inline-block;
      margin-top: 0.5rem;
      color: var(--muted);
      font-size: 0.9rem;
    }

    .excerpt {
      margin-top: 0.75rem;
      color: var(--muted);
      font-size: 1.05rem;
      line-height: 1.6;
    }

    .body {
      margin-top: 2rem;
      font-size: 1.15rem;
      color: var(--muted);
      line-height: 1.8;
    }
  </style>
</BaseLayout>