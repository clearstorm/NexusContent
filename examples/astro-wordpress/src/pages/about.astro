---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import ImageText from "../components/ImageText.astro";
import RichText from "../components/RichText.astro";
import Statistics from "../components/Statistics.astro";
import type { Props as HeroProps } from "../components/Hero.astro";
import type { Props as ImageTextProps } from "../components/ImageText.astro";
import type { Props as RichTextProps } from "../components/RichText.astro";
import type { Props as StatisticsProps } from "../components/Statistics.astro";
import { nexus } from "../nexus";
import { resolveSeo } from "@nexuscontent/core";
import { canonicalUrl, siteSeoDefaults } from "../app/seo";
import { resolveMediaFields } from "../app/media";

export interface AboutData {
  hero?: HeroProps;
  rich_text?: RichTextProps;
  image_text?: ImageTextProps;
  statistics?: StatisticsProps;
}

const page = await nexus.getPage("about");

if (!page) {
  throw new Error(`Required content "about" was not found.`);
}

const about = (await resolveMediaFields(nexus, page.data)) as AboutData;

const seo = resolveSeo({
  title: page.title ?? "About",
  seo: { ...page.seo, canonicalUrl: canonicalUrl("/about/") }
}, siteSeoDefaults);
---

<BaseLayout seo={seo}>
  {about.hero && <Hero {...about.hero} />}
  {about.rich_text && <RichText {...about.rich_text} />}
  {about.image_text && <ImageText {...about.image_text} />}
  {about.statistics && <Statistics {...about.statistics} />}
</BaseLayout>