---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import Services from "../components/Services.astro";
import Testimonials from "../components/Testimonials.astro";
import CTA from "../components/CTA.astro";
import SectionRenderer from "../components/SectionRenderer.astro";
import { getPageContent } from "../nexus";
import { resolveSeo } from "@nexuscontent/core";
import { canonicalUrl, siteSeoDefaults } from "../app/seo";
import type { WordPressExampleContent } from "../nexus";

const page = await getPageContent<WordPressExampleContent>("home");

if (!page) {
  throw new Error(`Required WordPress page "home" was not found.`);
}

const hasSections = Array.isArray(page.sections) && page.sections.length > 0;

const fields = (page.data.fields ?? {}) as Record<string, unknown>;

const hero = (fields.hero ?? {}) as {
  eyebrow?: string;
  heading: string;
  intro: string;
  cta?: { label: string; href: string };
};

const services = (fields.services ?? {}) as {
  heading: string;
  intro?: string;
  items: { title: string; description: string }[];
};

const testimonials = (fields.testimonials ?? {}) as {
  heading: string;
  items: { quote: string; author: string }[];
};

const serviceItems = Array.isArray(services.items) ? services.items : [];
const testimonialItems = Array.isArray(testimonials.items) ? testimonials.items : [];

const cta = (fields.cta ?? {}) as {
  heading: string;
  intro: string;
  label: string;
  href: string;
};

const seo = resolveSeo({
  title: page.title ?? "NexusContent WordPress Example",
  seo: { ...page.seo, canonicalUrl: canonicalUrl("/") }
}, siteSeoDefaults);
---

<BaseLayout seo={seo}>
  {hasSections ? (
    page.sections!.map((section) => <SectionRenderer section={section} />)
  ) : (
    <Hero {...hero} />
    <Services heading={services.heading} intro={services.intro} items={serviceItems} />
    <Testimonials heading={testimonials.heading} items={testimonialItems} />
    <CTA {...cta} />
  )}
</BaseLayout>
