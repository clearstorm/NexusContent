---
import BaseLayout from "../layouts/BaseLayout.astro";
import CTA from "../components/CTA.astro";
import Features from "../components/Features.astro";
import Gallery from "../components/Gallery.astro";
import Hero from "../components/Hero.astro";
import Intro from "../components/Intro.astro";
import Testimonials from "../components/Testimonials.astro";
import type { Props as CtaProps } from "../components/CTA.astro";
import type { Props as FeaturesProps } from "../components/Features.astro";
import type { Props as GalleryProps } from "../components/Gallery.astro";
import type { Props as HeroProps } from "../components/Hero.astro";
import type { Props as IntroProps } from "../components/Intro.astro";
import type { Props as TestimonialsProps } from "../components/Testimonials.astro";
import { nexus } from "../nexus";
import { canonicalUrl, resolvePageSeo } from "../app/seo";

export interface HomeData {
  hero?: HeroProps;
  intro?: IntroProps;
  features?: FeaturesProps;
  gallery?: GalleryProps;
  testimonials?: TestimonialsProps;
  cta?: CtaProps;
}

const page = await nexus.getPage("home");

if (!page) {
  throw new Error(`Required content "home" was not found.`);
}

// Projected sections arrive as a named map (`page.sections.<type>`), so the
// template composes sections declaratively the same way for Git and
// WordPress content.
const home = (await nexus.media.resolveFields(page.sections)) as HomeData;

const seo = await resolvePageSeo(nexus, {
  title: page.title ?? "Home",
  seo: { ...page.seo, canonicalUrl: canonicalUrl("/") }
});
---

<BaseLayout seo={seo}>
  {home.hero && <Hero {...home.hero} />}
  {home.intro && <Intro {...home.intro} />}
  {home.features && <Features {...home.features} />}
  {home.gallery && <Gallery {...home.gallery} />}
  {home.testimonials && <Testimonials {...home.testimonials} />}
  {home.cta && <CTA {...home.cta} />}
</BaseLayout>