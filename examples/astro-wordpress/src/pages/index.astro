---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import Services from "../components/Services.astro";
import Testimonials from "../components/Testimonials.astro";
import CTA from "../components/CTA.astro";
import { nexus } from "../nexus";
import { resolveSeo } from "@nexuscontent/core";
import { canonicalUrl, siteSeoDefaults } from "../app/seo";

const page = await nexus.getPage("home");

if (!page) {
  throw new Error(`Required WordPress page "home" was not found.`);
}

const { hero, services, testimonials, cta, contentBlocks } = page.data;

const seo = resolveSeo({
  title: page.title ?? "NexusContent WordPress Example",
  seo: { ...page.seo, canonicalUrl: canonicalUrl("/") }
}, siteSeoDefaults);
---

<BaseLayout seo={seo}>
  {hero && <Hero {...hero} />}
  {services && <Services heading={services.heading} intro={services.intro} items={services.items} />}
  {testimonials && <Testimonials heading={testimonials.heading} items={testimonials.items} />}
  {cta && <CTA {...cta} />}
 <!-- 
 {page.data.content && !(hero || mission || story) && (
    <article class="prose" set:html={page.data.content} />
  )}
  -->
</BaseLayout>