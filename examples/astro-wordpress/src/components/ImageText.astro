---
interface Image {
  src: string;
  alt?: string;
}

interface Button {
  label: string;
  url: string;
  variant?: string;
}

export interface Props {
  eyebrow?: string;
  heading: string;
  body?: string;
  image?: Image;
  image_position?: string;
  buttons?: Button[];
}

const { eyebrow, heading, body, image, image_position, buttons } = Astro.props;
const flip = image_position === "left" && Boolean(image?.src);
const btnClass = (variant: string | undefined) =>
  variant === "secondary" || variant === "light" ? "btn-light" : "btn-primary";
---

<section class="section image-text" class:list={{ flip }}>
  {image?.src && (
    <img class="media" src={image.src} alt={image.alt ?? ""} />
  )}
  <div class="copy">
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h2>{heading}</h2>
    {body && <div class="body" set:html={body} />}
    {buttons && buttons.length > 0 && (
      <div class="actions">
        {buttons.map((button) => (
          <a class={`btn ${btnClass(button.variant)}`} href={button.url}>{button.label}</a>
        ))}
      </div>
    )}
  </div>
  <style>
    .image-text {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 2.5rem;
      align-items: center;
    }

    .image-text.flip .copy {
      order: -1;
    }

    .image-text h2 {
      margin-top: 0.5rem;
    }

    .body {
      color: var(--muted);
      line-height: 1.7;
    }

    .actions {
      display: flex;
      gap: 0.75rem;
      flex-wrap: wrap;
      margin-top: 1.5rem;
    }

    .media {
      width: 100%;
      border-radius: var(--radius-lg);
      box-shadow: var(--shadow-md);
      object-fit: cover;
    }

    @media (max-width: 48rem) {
      .image-text {
        grid-template-columns: 1fr;
      }

      .image-text.flip .copy {
        order: initial;
      }
    }
  </style>
</section>