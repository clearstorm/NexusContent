---
interface Image {
  src: string;
  alt?: string;
}

interface Testimonial {
  quote: string;
  author: string;
  avatar?: Image;
}

export interface Props {
  eyebrow?: string;
  heading: string;
  items?: Testimonial[];
}

const { eyebrow, heading, items } = Astro.props;
---

<section class="section testimonials">
  {eyebrow && <p class="eyebrow">{eyebrow}</p>}
  <h2>{heading}</h2>
  {items && items.length > 0 && (
    <div class="grid">
      {
        items.map((item) => (
          <blockquote class="card">
            {item.avatar?.src && (
              <img class="avatar" src={item.avatar.src} alt={item.avatar.alt ?? ""} />
            )}
            <p class="quote">"{item.quote}"</p>
            <footer>— {item.author}</footer>
          </blockquote>
        ))
      }
    </div>
  )}
  <style>
    .grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(18rem, 1fr));
      gap: 1.5rem;
      margin-top: 1.5rem;
    }

    .card {
      margin: 0;
      border: 1px solid var(--border);
      border-left: 4px solid var(--accent);
      border-radius: var(--radius);
      padding: 1.5rem;
      background: var(--surface);
      box-shadow: var(--shadow-sm);
    }

    .avatar {
      width: 2.75rem;
      height: 2.75rem;
      border-radius: 50%;
      object-fit: cover;
      margin-bottom: 0.75rem;
    }

    .quote {
      margin: 0 0 0.75rem;
      color: var(--fg);
    }

    .card footer {
      color: var(--muted);
      font-size: 0.9rem;
    }
  </style>
</section>