---
interface Image {
  src: string;
  alt?: string;
}

interface Button {
  label: string;
  url: string;
  variant?: string;
}

export interface Props {
  eyebrow?: string;
  heading: string;
  body?: string;
  image?: Image;
  buttons?: Button[];
}

const { eyebrow, heading, body, image, buttons } = Astro.props;
const btnClass = (variant: string | undefined) =>
  variant === "secondary" || variant === "light" ? "btn-light" : "btn-primary";
---

<section class="hero">
  <div class="copy">
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h1>{heading}</h1>
    {body && <p class="body">{body}</p>}
    {buttons && buttons.length > 0 && (
      <div class="actions">
        {buttons.map((button) => (
          <a class={`btn ${btnClass(button.variant)}`} href={button.url}>{button.label}</a>
        ))}
      </div>
    )}
  </div>
  {image && image.src && (
    <img class="media" src={image.src} alt={image.alt ?? ""} />
  )}
  <style>
    .hero {
      display: grid;
      grid-template-columns: 1.2fr 0.8fr;
      gap: 2rem;
      align-items: center;
      overflow: hidden;
      background: linear-gradient(135deg, var(--accent), var(--accent-2));
      border-radius: var(--radius-lg);
      padding: 3.5rem 2.5rem;
      color: #ffffff;
    }

    .hero .eyebrow {
      color: #e0e7ff;
    }

    .hero h1 {
      margin: 0.5rem 0 1rem;
      font-size: clamp(2.25rem, 6vw, 3.5rem);
      max-width: 34rem;
    }

    .hero .body {
      margin: 0 0 1.75rem;
      font-size: 1.2rem;
      color: #e0e7ff;
      max-width: 36rem;
    }

    .hero .actions {
      display: flex;
      gap: 0.75rem;
      flex-wrap: wrap;
    }

    .hero .media {
      width: 100%;
      height: 100%;
      max-height: 22rem;
      object-fit: cover;
      border-radius: var(--radius);
      box-shadow: var(--shadow-md);
    }

    @media (max-width: 48rem) {
      .hero {
        grid-template-columns: 1fr;
      }

      .hero .media {
        max-height: 16rem;
      }
    }
  </style>
</section>