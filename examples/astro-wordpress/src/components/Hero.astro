---
interface Props {
  eyebrow?: string;
  heading: string;
  intro: string;
  cta?: {
    label: string;
    href: string;
  };
}

const { eyebrow, heading, intro, cta } = Astro.props;
---

<section class="hero">
  {eyebrow && <p class="eyebrow">{eyebrow}</p>}
  <h1>{heading}</h1>
  <p class="intro">{intro}</p>
  {cta && (
    <a class="btn btn-light" href={cta.href}>
      {cta.label}
    </a>
  )}
  <style>
    .hero {
      position: relative;
      overflow: hidden;
      background: linear-gradient(135deg, var(--accent), var(--accent-2));
      border-radius: var(--radius-lg);
      padding: 3.5rem 2.5rem;
      color: #ffffff;
    }

    .hero::after {
      content: "";
      position: absolute;
      right: -6rem;
      top: -6rem;
      width: 18rem;
      height: 18rem;
      border-radius: 50%;
      background: rgba(255, 255, 255, 0.1);
    }

    .hero .eyebrow {
      color: #e0e7ff;
    }

    .hero h1 {
      margin: 0.5rem 0 1rem;
      font-size: clamp(2.25rem, 6vw, 4rem);
      max-width: 32rem;
      position: relative;
    }

    .hero .intro {
      margin: 0 0 1.75rem;
      font-size: 1.25rem;
      color: #e0e7ff;
      max-width: 40rem;
      position: relative;
    }

    .hero .btn {
      position: relative;
    }
  </style>
</section>
