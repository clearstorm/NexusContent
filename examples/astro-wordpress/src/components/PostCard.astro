---
interface Image {
  src: string;
  alt?: string;
}

interface Props {
  title?: string;
  slug?: string;
  date?: string;
  excerpt?: string;
  image?: Image;
}

const { title, slug, date, excerpt, image } = Astro.props;
const href = `/blog/${slug ?? ""}`;
const more = "Read more";
---

<article class="card">
  {image?.src && (
    <a class="media" href={href}>
      <img src={image.src} alt={image.alt ?? ""} loading="lazy" />
    </a>
  )}
  <a class="title" href={href}>
    <h2>{title ?? "Untitled"}</h2>
  </a>
  {date && <time>{date}</time>}
  {excerpt && <p class="excerpt">{excerpt}</p>}
  <a class="more" href={href}>{more}</a>
  <style>
    .card {
      display: flex;
      flex-direction: column;
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 1.5rem;
      background: var(--surface);
      box-shadow: var(--shadow-sm);
      transition: transform 0.15s ease, box-shadow 0.15s ease;
    }

    .card:hover {
      transform: translateY(-3px);
      box-shadow: var(--shadow-md);
    }

    .media img {
      width: 100%;
      height: 10rem;
      object-fit: cover;
      border-radius: var(--radius);
      margin-bottom: 1rem;
    }

    .title {
      text-decoration: none;
    }

    .title h2 {
      margin: 0 0 0.5rem;
      color: var(--fg);
    }

    time {
      color: var(--muted);
      font-size: 0.85rem;
    }

    .excerpt {
      color: var(--muted);
      margin: 0.75rem 0 1rem;
    }

    .more {
      margin-top: auto;
      font-weight: 600;
      text-decoration: none;
      font-size: 0.9rem;
    }
  </style>
</article>
