---
export interface Props {
  heading?: string;
  provider?: string;
  form_id?: string;
  embed_code?: string;
}

const { heading, provider, form_id, embed_code } = Astro.props;
---

<section class="section form-embed">
  {heading && <h2>{heading}</h2>}
  {provider && form_id && (
    <p class="meta">
      Form {form_id} via {provider}
    </p>
  )}
  {embed_code ? (
    <div class="embed" set:html={embed_code} />
  ) : (
    <p class="placeholder">Embed your form script here.</p>
  )}
  <style>
    .meta {
      color: var(--muted);
      font-size: 0.9rem;
      margin-bottom: 1.5rem;
    }

    .embed {
      max-width: 40rem;
      min-height: 8rem;
    }

    .embed :global(form) {
      display: flex;
      flex-direction: column;
      gap: 1rem;
    }

    .placeholder {
      color: var(--muted);
      border: 1px dashed var(--border);
      border-radius: var(--radius);
      padding: 3rem 1.5rem;
      text-align: center;
    }
  </style>
</section>