---
interface Image {
  src: string;
  alt?: string;
}

interface Button {
  label: string;
  url: string;
  variant?: string;
}

export interface Props {
  heading: string;
  body?: string;
  buttons?: Button[];
  background_image?: Image;
}

const { heading, body, buttons, background_image } = Astro.props;
const btnClass = (variant: string | undefined) =>
  variant === "secondary" || variant === "light" ? "btn-light" : "btn-primary";
---

<section class="cta">
  <h2>{heading}</h2>
  {body && <p>{body}</p>}
  {buttons && buttons.length > 0 && (
    <div class="actions">
      {buttons.map((button) => (
        <a class={`btn ${btnClass(button.variant)}`} href={button.url}>{button.label}</a>
      ))}
    </div>
  )}
  <style>
    .cta {
      margin-top: 3.5rem;
      padding: 3rem 2.5rem;
      text-align: center;
      border: 1px solid var(--border);
      border-radius: var(--radius-lg);
      background:
        {background_image?.src
          ? `linear-gradient(rgba(15, 23, 42, 0.75), rgba(15, 23, 42, 0.75)), url("${background_image.src}") center / cover no-repeat`
          : "linear-gradient(135deg, var(--accent-soft), #faf5ff)"};
      color: {background_image?.src ? "#ffffff" : "inherit"};
    }

    .cta h2 {
      margin-top: 0;
    }

    .cta p {
      color: var(--muted);
      max-width: 36rem;
      margin: 0 auto 1.5rem;
    }

    .cta .actions {
      display: flex;
      gap: 0.75rem;
      justify-content: center;
      flex-wrap: wrap;
    }

    .cta .btn-light {
      background: #ffffff;
      color: var(--accent);
    }
  </style>
</section>