---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import NexusSeo from "../components/NexusSeo.astro";
import { nexus } from "../nexus";
import type { SeoData } from "@nexuscontent/core";
import "../styles/global.css";

interface Props {
  seo: SeoData;
}

const { seo } = Astro.props;
const lang = "en";

// Navigation and settings are declared as NexusContent models wired to the Git
// provider (the WordPress provider serves pages and posts only, and returns
// null for navigation/settings). They are required for the shell, so a missing
// model fails the build rather than silently falling back to app-side copy.
const nav = await nexus.getNavigation("primary");
if (!nav) {
  throw new Error(`Required navigation "primary" was not found.`);
}

const sites = await nexus.getSettings("site");
if (!sites) {
  throw new Error(`Required settings "site" was not found.`);
}

const navItems = nav.items;
const siteData = sites.data;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <NexusSeo seo={seo} />
  </head>
  <body>
    <Header links={navItems} />
    <main>
      <slot />
    </main>
    <Footer site={siteData} />
  </body>
</html>
