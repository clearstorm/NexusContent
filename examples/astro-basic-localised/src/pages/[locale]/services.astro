---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Hero from "../../components/Hero.astro";
import Services from "../../components/Services.astro";
import RichTextContent from "../../components/RichTextContent.astro";
import { nexus } from "../../nexus";
import { supportedLocales } from "../../app/locale";
import { resolveSeo } from "@nexuscontent/core";
import { canonicalUrl, siteSeoDefaults } from "../../app/seo";
import { resolveHero, resolveServices } from "../../app/media";

export function getStaticPaths() {
  return supportedLocales.map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params;

const page = await nexus.getPage("services", { locale });

if (!page) {
  throw new Error(`Required content "services" was not found for locale "${locale}".`);
}

const hero = await resolveHero(nexus, page.data.hero);
const services = await resolveServices(nexus, page.data.servicesList);
const { richTextContent } = page.data;

const seo = resolveSeo({
  title: page.title ?? "Services",
  seo: { ...page.seo, canonicalUrl: canonicalUrl(`/${locale}/services/`) }
}, siteSeoDefaults());
---

<BaseLayout
  seo={seo}
  locale={locale}
>
  {hero && <Hero {...hero} />}
  {services && <Services {...services} />}
  {richTextContent && <RichTextContent {...richTextContent} />}
</BaseLayout>