---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Hero from "../../components/Hero.astro";
import CTA from "../../components/CTA.astro";
import { nexus } from "../../nexus";
import { supportedLocales } from "../../app/locale";
import { resolveSeo } from "@nexuscontent/core";
import { canonicalUrl, siteSeoDefaults } from "../../app/seo";

export function getStaticPaths() {
  return supportedLocales.map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params;

const page = await nexus.getPage("services", { locale });

if (!page) {
  throw new Error(`Required content "services" was not found for locale "${locale}".`);
}

const { hero, services, cta } = page.data;

const seo = resolveSeo({
  title: page.title ?? "Services",
  seo: { ...page.seo, canonicalUrl: canonicalUrl(`/${locale}/services/`) }
}, siteSeoDefaults());
---

<BaseLayout
  seo={seo}
  locale={locale}
>
  <Hero {...hero} locale={locale} />

  <section class="section services">
    <h2>{services.heading}</h2>
    {services.intro && <p class="lede">{services.intro}</p>}
    <div class="grid">
      {
        services.items.map((service, index) => (
          <article class="card">
            <span class="num">{index + 1}</span>
            <h3>{service.title}</h3>
            <p>{service.description}</p>
            <ul>
              {service.points.map((point) => (
                <li>{point}</li>
              ))}
            </ul>
          </article>
        ))
      }
    </div>
  </section>

  <CTA {...cta} locale={locale} />

  <style>
    .lede {
      color: var(--muted);
      max-width: 44rem;
    }

    .grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(18rem, 1fr));
      gap: 1.5rem;
      margin-top: 1.5rem;
    }

    .card {
      position: relative;
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 1.5rem;
      background: var(--surface);
      box-shadow: var(--shadow-sm);
    }

    .card h3 {
      margin-top: 0.75rem;
    }

    .card ul {
      margin: 0.75rem 0 0;
      padding-left: 1.1rem;
      color: var(--muted);
    }

    .card li + li {
      margin-top: 0.25rem;
    }

    .num {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 2rem;
      height: 2rem;
      border-radius: 0.5rem;
      background: var(--accent-soft);
      color: var(--accent);
      font-weight: 700;
      font-size: 0.9rem;
    }
  </style>
</BaseLayout>
