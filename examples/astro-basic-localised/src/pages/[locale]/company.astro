---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Hero from "../../components/Hero.astro";
import RichTextContent from "../../components/RichTextContent.astro";
import ImageGallery from "../../components/ImageGallery.astro";
import { nexus } from "../../nexus";
import { supportedLocales } from "../../app/locale";
import { resolveSeo } from "@nexuscontent/core";
import { canonicalUrl, siteSeoDefaults } from "../../app/seo";
import { resolveHero, resolveGallery } from "../../app/media";

export function getStaticPaths() {
  return supportedLocales.map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params;

const page = await nexus.getPage("about", { locale });

if (!page) {
  throw new Error(`Required content "about" was not found for locale "${locale}".`);
}

const hero = await resolveHero(nexus, page.data.hero);
const gallery = await resolveGallery(nexus, page.data.imageGallery);
const { richTextContent } = page.data;

const seo = resolveSeo({
  title: page.title ?? "About",
  seo: { ...page.seo, canonicalUrl: canonicalUrl(`/${locale}/company/`) }
}, siteSeoDefaults());
---

<BaseLayout
  seo={seo}
  locale={locale}
>
  {hero && <Hero {...hero} />}
  {richTextContent && <RichTextContent {...richTextContent} />}
  {gallery && <ImageGallery {...gallery} />}
</BaseLayout>