---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Hero from "../../components/Hero.astro";
import RichTextContent from "../../components/RichTextContent.astro";
import ImageGallery from "../../components/ImageGallery.astro";
import { nexus } from "../../nexus";
import { supportedLocales } from "../../app/locale";
import { canonicalUrl } from "../../app/seo";

export function getStaticPaths() {
  return supportedLocales.map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params;

const page = await nexus.getPage("about", { locale });

if (!page) {
  throw new Error(`Required content "about" was not found for locale "${locale}".`);
}

const { hero, imageGallery, richTextContent } =
  await nexus.media.resolveFields(page.data);

const seo = await nexus.resolvePageSeo({
  title: page.title ?? "About",
  seo: { ...page.seo, canonicalUrl: canonicalUrl(`/${locale}/company/`) }
}, { locale });
---

<BaseLayout
  seo={seo}
  locale={locale}
>
  {hero && <Hero {...hero} />}
  {richTextContent && <RichTextContent {...richTextContent} />}
  {imageGallery && <ImageGallery {...imageGallery} />}
</BaseLayout>