---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import PostCard from "../../../components/PostCard.astro";
import { getCollectionContent } from "../../../nexus";
import { supportedLocales } from "../../../app/locale";

export function getStaticPaths() {
  return supportedLocales.map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params;

const posts = await getCollectionContent("blog", { locale });

const intro =
  locale === "fr"
    ? "Des articles du dépôt de contenu Git."
    : "Posts from the Git content repository.";
---

<BaseLayout
  title="Blog - NexusContent Example"
  description={intro}
  locale={locale}
>
  <header class="page-head">
    <p class="eyebrow">Blog</p>
    <h1>{intro}</h1>
  </header>

  <div class="posts">
    {
      posts.map((post) => (
        <PostCard
          locale={locale}
          title={post.title}
          slug={post.slug ?? post.key}
          date={(post.data as { date?: string }).date}
          excerpt={(post.data as { excerpt?: string }).excerpt}
        />
      ))
    }
  </div>

  <style>
    .page-head h1 {
      margin-top: 0.25rem;
      font-size: clamp(1.75rem, 4vw, 2.5rem);
    }

    .posts {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(18rem, 1fr));
      gap: 1.5rem;
      margin-top: 1.5rem;
    }
  </style>
</BaseLayout>
