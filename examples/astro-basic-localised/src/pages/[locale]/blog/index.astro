---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import PostCard from "../../../components/PostCard.astro";
import { nexus } from "../../../nexus";
import { supportedLocales } from "../../../app/locale";
import { resolveSeo } from "@nexuscontent/core";
import { canonicalUrl, siteSeoDefaults } from "../../../app/seo";

export function getStaticPaths() {
  return supportedLocales.map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params;

const posts = await nexus.getCollection("blog", { locale });

const intro =
  locale === "fr"
    ? "Des articles du dépôt de contenu Git."
    : "Posts from the Git content repository.";
const seo = resolveSeo({
  title: "Blog - NexusContent Example",
  seo: { description: intro, canonicalUrl: canonicalUrl(`/${locale}/blog/`) }
}, siteSeoDefaults());
---

<BaseLayout
  seo={seo}
  locale={locale}
>
  <header class="page-head">
    <p class="eyebrow">Blog</p>
    <h1>{intro}</h1>
  </header>

  <div class="posts">
    {
      posts.map((post) => (
        <PostCard
          locale={locale}
          title={post.title}
          slug={post.slug ?? post.key}
          date={post.data.date}
          excerpt={post.data.excerpt}
        />
      ))
    }
  </div>

  <style>
    .page-head h1 {
      margin-top: 0.25rem;
      font-size: clamp(1.75rem, 4vw, 2.5rem);
    }

    .posts {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(18rem, 1fr));
      gap: 1.5rem;
      margin-top: 1.5rem;
    }
  </style>
</BaseLayout>
