---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { nexus } from "../../../nexus";
import { supportedLocales, localizeHref } from "../../../app/locale";
import { resolveSeo } from "@nexuscontent/core";
import { canonicalUrl, siteSeoDefaults } from "../../../app/seo";

export async function getStaticPaths() {
  const paths: {
    params: { locale: string; slug: string };
    props: { key: string };
  }[] = [];

  for (const locale of supportedLocales) {
    const posts = await nexus.getCollection("blog", { locale });
    for (const post of posts) {
      paths.push({
        params: { locale, slug: post.slug ?? post.key },
        props: { key: post.key }
      });
    }
  }

  return paths;
}

const { locale, slug } = Astro.params;
interface Props {
  key: string;
}
const { key } = Astro.props;

const post = await nexus.getItem("blog", key, { locale });

if (!post) {
  throw new Error(
    `Required content "${key ?? slug}" was not found for locale "${locale}".`
  );
}

const { body, date, excerpt } = post.data;
const postTitle = post.title ?? "Post";
const postUrl = canonicalUrl(`/${locale}/blog/${post.slug ?? post.key}/`);
const seo = resolveSeo({
  title: `${postTitle} - NexusContent Example`,
  seo: {
    description: excerpt,
    canonicalUrl: postUrl,
    openGraph: { type: "article" },
    structuredData: [
      {
        "@context": "https://schema.org",
        "@type": "BlogPosting",
        headline: postTitle,
        url: postUrl,
        inLanguage: locale,
        ...(date ? { datePublished: date } : {})
      }
    ]
  }
}, siteSeoDefaults());
---

<BaseLayout
  seo={seo}
  locale={locale}
>
  <article class="post">
    <p class="back">
      <a href={localizeHref(locale, "/blog")}>← Blog</a>
    </p>
    <h1>{post.title}</h1>
    {date && <time>{date}</time>}
    {body && <p class="body">{body}</p>}
  </article>

  <style>
    .post {
      max-width: 46rem;
    }

    .back a {
      color: var(--muted);
      text-decoration: none;
      font-size: 0.9rem;
    }

    .back a:hover {
      color: var(--accent);
    }

    .post time {
      display: inline-block;
      margin-top: 0.5rem;
      color: var(--muted);
      font-size: 0.9rem;
    }

    .body {
      margin-top: 2rem;
      font-size: 1.15rem;
      color: var(--muted);
      line-height: 1.8;
    }
  </style>
</BaseLayout>
