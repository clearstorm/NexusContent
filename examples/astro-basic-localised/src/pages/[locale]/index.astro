---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Hero from "../../components/Hero.astro";
import Services from "../../components/Services.astro";
import Testimonials from "../../components/Testimonials.astro";
import { nexus } from "../../nexus";
import { supportedLocales } from "../../app/locale";
import { canonicalUrl } from "../../app/seo";

export function getStaticPaths() {
  return supportedLocales.map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params;

const page = await nexus.getPage("home", { locale });

if (!page) {
  throw new Error(`Required content "home" was not found for locale "${locale}".`);
}

// resolveFields() recursively resolves every authored media reference in the
// page data before the components render. The home hero image has no provider,
// so it resolves through the configured default "local" media provider.
const { hero, servicesList, testimonialsList } =
  await nexus.media.resolveFields(page.data);

const seo = await nexus.resolvePageSeo({
  title: page.title ?? "Home",
  seo: { ...page.seo, canonicalUrl: canonicalUrl(`/${locale}/`) }
}, { locale });
---

<BaseLayout
  seo={seo}
  locale={locale}
>
  {hero && <Hero {...hero} />}
  {servicesList && <Services {...servicesList} />}
  {testimonialsList && <Testimonials {...testimonialsList} />}
</BaseLayout>