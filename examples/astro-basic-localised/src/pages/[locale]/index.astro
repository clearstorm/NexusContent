---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Hero from "../../components/Hero.astro";
import Services from "../../components/Services.astro";
import Testimonials from "../../components/Testimonials.astro";
import CTA from "../../components/CTA.astro";
import { nexus } from "../../nexus";
import { supportedLocales } from "../../app/locale";
import { resolveSeo } from "@nexuscontent/core";
import { canonicalUrl, siteSeoDefaults } from "../../app/seo";

export function getStaticPaths() {
  return supportedLocales.map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params;

const page = await nexus.getPage("home", { locale });

if (!page) {
  throw new Error(`Required content "home" was not found for locale "${locale}".`);
}

const { hero, services, testimonials, cta } = page.data;

const seo = resolveSeo({
  title: page.title ?? "NexusContent Example",
  seo: { ...page.seo, canonicalUrl: canonicalUrl(`/${locale}/`) }
}, siteSeoDefaults());
---

<BaseLayout
  seo={seo}
  locale={locale}
>
  <Hero {...hero} locale={locale} />
  <Services {...services} />
  <Testimonials {...testimonials} />
  <CTA {...cta} locale={locale} />
</BaseLayout>
