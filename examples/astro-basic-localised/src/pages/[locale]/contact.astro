---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Hero from "../../components/Hero.astro";
import RichTextContent from "../../components/RichTextContent.astro";
import ContactDetails from "../../components/ContactDetails.astro";
import { nexus } from "../../nexus";
import { supportedLocales } from "../../app/locale";
import { resolveSeo } from "@nexuscontent/core";
import { canonicalUrl, siteSeoDefaults } from "../../app/seo";
import { resolveHero } from "../../app/media";

export function getStaticPaths() {
  return supportedLocales.map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params;

const page = await nexus.getPage("contact", { locale });

if (!page) {
  throw new Error(`Required content "contact" was not found for locale "${locale}".`);
}

// Contact details live in the site settings, so every page can reuse them.
const settings = await nexus.getSettings("site", { locale });

if (!settings) {
  throw new Error(`Required settings "site" was not found for locale "${locale}".`);
}

const hero = await resolveHero(nexus, page.data.hero);
const { introduction } = page.data;
const { contactDetails } = settings.data;

const seo = resolveSeo({
  title: page.title ?? "Contact",
  seo: { ...page.seo, canonicalUrl: canonicalUrl(`/${locale}/contact/`) }
}, siteSeoDefaults());
---

<BaseLayout
  seo={seo}
  locale={locale}
>
  {hero && <Hero {...hero} />}
  {introduction && <RichTextContent {...introduction} />}
  {contactDetails && <ContactDetails {...contactDetails} />}
</BaseLayout>