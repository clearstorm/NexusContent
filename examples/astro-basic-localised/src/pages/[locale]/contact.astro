---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Hero from "../../components/Hero.astro";
import CTA from "../../components/CTA.astro";
import { getPageContent } from "../../nexus";
import { supportedLocales } from "../../app/locale";
import { resolveSeo } from "@nexuscontent/core";
import { canonicalUrl, siteSeoDefaults } from "../../app/seo";

export function getStaticPaths() {
  return supportedLocales.map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params;

const page = await getPageContent("contact", { locale });

if (!page) {
  throw new Error(`Required content "contact" was not found for locale "${locale}".`);
}

const hero = page.data.hero as {
  eyebrow?: string;
  heading: string;
  intro: string;
};

const contact = page.data.contact as {
  heading: string;
  items: { label: string; value: string; href?: string }[];
};

const cta = page.data.cta as {
  heading: string;
  intro: string;
  label: string;
  href: string;
};

const seo = resolveSeo({
  title: page.title ?? "Contact",
  seo: { ...page.seo, canonicalUrl: canonicalUrl(`/${locale}/contact/`) }
}, siteSeoDefaults());
---

<BaseLayout
  seo={seo}
  locale={locale}
>
  <Hero {...hero} locale={locale} />

  <section class="section details">
    <h2>{contact.heading}</h2>
    <div class="grid">
      {
        contact.items.map((detail) => (
          <article class="card">
            <h3>{detail.label}</h3>
            {detail.href ? (
              <a href={detail.href}>{detail.value}</a>
            ) : (
              <p>{detail.value}</p>
            )}
          </article>
        ))
      }
    </div>
  </section>

  <CTA {...cta} locale={locale} />

  <style>
    .grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
      gap: 1.5rem;
      margin-top: 1.5rem;
    }

    .card {
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 1.5rem;
      background: var(--surface);
      box-shadow: var(--shadow-sm);
    }

    .card h3 {
      margin-top: 0;
    }

    .card p {
      margin: 0;
      color: var(--muted);
    }

    .card a {
      font-weight: 600;
      word-break: break-word;
    }
  </style>
</BaseLayout>
