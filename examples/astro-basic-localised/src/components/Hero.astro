---
import Button from "./Button.astro";

interface Props {
  heading: string;
  intro?: string;
  image: {
    src: string;
    alt?: string;
  };
  cta?: {
    label: string;
    href: string;
    variant?: string;
  };
}

const { heading, intro, image, cta } = Astro.props;
---

<section class="hero">
  <h1>{heading}</h1>
  {intro && <p class="intro">{intro}</p>}
  {cta && (
    <Button label={cta.label} href={cta.href} variant={cta.variant} />
  )}
  {image.src && (
    <img
      class="hero-image"
      src={image.src}
      alt={image.alt ?? ""}
      width={1200}
      height={630}
    />
  )}
  <style>
    .hero {
      position: relative;
      overflow: hidden;
      background: linear-gradient(135deg, var(--accent), var(--accent-2));
      border-radius: var(--radius-lg);
      padding: 3.5rem 2.5rem;
      color: #ffffff;
    }

    .hero::after {
      content: "";
      position: absolute;
      right: -6rem;
      top: -6rem;
      width: 18rem;
      height: 18rem;
      border-radius: 50%;
      background: rgba(255, 255, 255, 0.1);
    }

    .hero h1 {
      margin: 0 0 1rem;
      font-size: clamp(2.25rem, 6vw, 4rem);
      max-width: 32rem;
      position: relative;
    }

    .hero .intro {
      margin: 0 0 1.75rem;
      font-size: 1.25rem;
      color: #e0e7ff;
      max-width: 40rem;
      position: relative;
    }

    .hero .btn {
      position: relative;
    }

    .hero .hero-image {
      display: block;
      margin-top: 1.75rem;
      max-width: 100%;
      height: auto;
      border-radius: var(--radius);
      box-shadow: var(--shadow-md);
      position: relative;
    }
  </style>
</section>