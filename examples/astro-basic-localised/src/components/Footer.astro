---
import { localizeHref } from "../app/locale";

interface SiteFooter {
  description?: string;
  credit?: string;
}

interface SiteData {
  siteName?: string;
  tagline?: string;
  footer?: SiteFooter;
}

interface Props {
  locale: string;
  site?: SiteData;
}

const { locale, site } = Astro.props;
const homeLabel = locale === "fr" ? "Accueil" : "Home";
---

<footer>
  <div class="cols">
    <div class="brand">
      <strong>{site?.siteName ?? "NexusContent"}</strong>
      {site?.tagline && <p>{site.tagline}</p>}
    </div>
    <div class="desc">
      {site?.footer?.description && <p>{site.footer.description}</p>}
      <a class="home" href={localizeHref(locale, "/")}>{homeLabel}</a>
    </div>
  </div>
  <p class="credit">
    {site?.footer?.credit ?? "Powered by NexusContent."}
  </p>
  <style>
    footer {
      border-top: 1px solid var(--border);
      background: var(--fg);
      color: #e7e5e4;
    }

    .cols {
      max-width: var(--maxw);
      margin: 0 auto;
      padding: 2.5rem 1.5rem 1.25rem;
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
      gap: 2rem;
    }

    .brand strong {
      font-size: 1.1rem;
      color: #ffffff;
    }

    .brand p,
    .desc p {
      color: #a8a29e;
      margin: 0.5rem 0 0;
      max-width: 32rem;
    }

    .home {
      display: inline-block;
      margin-top: 0.75rem;
      color: #c7d2fe;
      text-decoration: none;
      font-weight: 600;
    }

    .credit {
      max-width: var(--maxw);
      margin: 0 auto;
      padding: 1.25rem 1.5rem 1.75rem;
      border-top: 1px solid rgba(255, 255, 255, 0.12);
      color: #78716c;
      font-size: 0.85rem;
    }
  </style>
</footer>
