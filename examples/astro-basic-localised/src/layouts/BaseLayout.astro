---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import NexusSeo from "../components/NexusSeo.astro";
import { nexus } from "../nexus";
import { defaultLocale, isSupportedLocale } from "../app/locale";
import type { SeoData } from "@nexuscontent/core";
import "../styles/global.css";

interface Props {
  seo: SeoData;
  locale: string;
}

const { seo, locale } = Astro.props;
const lang = isSupportedLocale(locale) ? locale : defaultLocale;

const navigation = await nexus.getNavigation("primary", { locale: lang });
const site = await nexus.getSettings("site", { locale: lang });

if (!navigation) {
  throw new Error(
    `Required navigation "primary" was not found for locale "${lang}".`
  );
}

if (!site) {
  throw new Error(`Required settings "site" was not found for locale "${lang}".`);
}
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <NexusSeo seo={seo} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <Header links={navigation.items} locale={lang} />
    <main>
      <slot />
    </main>
    <Footer site={site.data} locale={lang} />
  </body>
</html>
