# Astro basic localised example environment
#
# Path to the content repository used by the Git content provider.
# Relative to this directory (examples/astro-basic-localised).
#
# The committed default reads content from ./content inside the example.
# To consume an external GitHub-hosted content repository, point this at a
# local clone, for example a sibling directory of the application repository:
#   NEXUS_GIT_CONTENT_PATH=../../../client-content/content
NEXUS_GIT_CONTENT_PATH=content
