# NexusContent environment variables
#
# Copy this file to .env and fill in values for your environment.
# Never commit real secrets.

# Git content provider: absolute or relative path to the content repository.
NEXUS_GIT_CONTENT_PATH=

# WordPress provider: full REST API root. HTTPS is recommended outside local development.
WORDPRESS_API_URL=https://example.com/wp-json/wp/v2

# Optional protected API token. Consumers decide how to turn this into a request header.
WORDPRESS_API_TOKEN=

# nexus-contract CLI, push mode: Application Password credentials
# (https://make.wordpress.org/core/2020/11/05/application-passwords-integration-guide/).
# Install a user with manage_options and create an Application Password for them.
# WORDPRESS_API_URL is reused as the REST API root.
WORDPRESS_USERNAME=
WORDPRESS_APP_PASSWORD=

# Future provider:
# STRAPI_API_URL=
# STRAPI_API_TOKEN=
