# NexusContent environment variables
#
# Copy this file to .env and fill in values for your environment.
# Never commit real secrets.

# Git content provider: absolute or relative path to the content repository.
NEXUS_GIT_CONTENT_PATH=

# WordPress provider: full REST API root. HTTPS is recommended outside local development.
WORDPRESS_API_URL=https://example.com/wp-json/wp/v2

# Optional protected API token. Consumers decide how to turn this into a request header.
WORDPRESS_API_TOKEN=

# Future provider:
# STRAPI_API_URL=
# STRAPI_API_TOKEN=
